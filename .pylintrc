# Reglas de estilo del proyecto para Pylint (VS Code).
[FORMAT]
max-line-length=130

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    invalid-name,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    too-many-return-statements,
    too-many-arguments,
    too-many-positional-arguments,
    too-many-lines,
    broad-exception-caught,
    import-outside-toplevel,
    wrong-import-position,
    consider-using-with,
    redefined-outer-name,
    unused-argument
